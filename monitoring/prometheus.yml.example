# 복사해서 쓰세요:  cp monitoring/prometheus.yml.example monitoring/prometheus.yml
# 그리고 targets를 SUT(박스)의 LAN IP로 바꾸세요.
# (Prometheus 설정은 env 치환을 지원하지 않아 파일에 직접 적습니다. 그래서 실제 prometheus.yml은 .gitignore.)
global:
  scrape_interval: 5s

scrape_configs:
  - job_name: locus
    metrics_path: /actuator/prometheus
    static_configs:
      # ↓ SUT(박스) IP:8093 으로 수정. 앱이 같은 호스트면 host.docker.internal:8093
      - targets: ["192.168.0.10:8093"]

  # 박스 호스트 메트릭(디스크 %util·쓰기 지연·평균 요청 크기 등). 박스 docker-compose의 node-exporter(9100).
  - job_name: node
    static_configs:
      # ↓ SUT(박스) IP:9100 으로 수정.
      - targets: ["192.168.0.10:9100"]
