# 로컬 개발용 환경변수 템플릿.
#   사용:  cp .env.example .env   (docker-compose가 .env를 자동으로 읽음)
# 실제 .env는 .gitignore 대상 — 절대 커밋하지 않는다(SECURITY.md).
# 아래 값은 로컬 docker-compose 전용 throwaway. 실제 환경에선 안전한 값으로 교체.

# --- MySQL 컨테이너 (docker-compose) ---
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=locus
MYSQL_USER=locus
MYSQL_PASSWORD=locuspw

# Locus docker MySQL이 호스트에 발행할 포트. 기본 3306.
# 측정 박스엔 시스템 MySQL이 이미 3306을 점유 → 박스 .env에선 3307로 분리.
MYSQL_HOST_PORT=3306

# --- 애플리케이션 (Spring) ---
# 박스(시스템 MySQL 공존)에선 포트를 MYSQL_HOST_PORT와 맞춘다: ...localhost:3307/locus...
# rewriteBatchedStatements=true: M1 A2 배치 적재가 멀티로우 INSERT로 묶이게 한다(박스도 필수).
DB_URL=jdbc:mysql://localhost:3306/locus?serverTimezone=UTC&characterEncoding=UTF-8&rewriteBatchedStatements=true
DB_USERNAME=locus
DB_PASSWORD=locuspw

# --- 인증 (M4에서 추가) ---
# JWT_SECRET=    # 실제 비밀. 커밋 금지. M4 인증 구현 시 채움.
