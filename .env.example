# 로컬/박스 개발·측정용 환경변수 템플릿.
#   사용:  cp .env.example .env   후 값 수정
#   - docker-compose가 .env를 자동으로 읽음 → POSTGRES_* 사용.
#   - 앱은 scripts/run-app.sh가 .env를 export해서 DB_URL/DB_USERNAME/DB_PASSWORD를 읽음.
# 실제 .env는 .gitignore 대상 — 절대 커밋하지 않는다(SECURITY.md).
# 아래 값은 throwaway. 실제 환경에선 안전한 값으로 교체.

# --- TimescaleDB(PostgreSQL) 컨테이너 (docker-compose가 읽음) ---
POSTGRES_DB=locus
POSTGRES_USER=locus
POSTGRES_PASSWORD=locuspw

# Locus docker DB가 호스트에 발행할 포트. 기본 5432.
# ⚠️ 이 값과 아래 DB_URL의 포트는 반드시 같아야 한다.
# 박스에 시스템 PostgreSQL이 5432를 점유하면 분리:
#   예) DB_HOST_PORT=5433  +  DB_URL=jdbc:postgresql://localhost:5433/locus?...
DB_HOST_PORT=5432

# --- 애플리케이션 (Spring; scripts/run-app.sh가 .env를 export해 전달) ---
# reWriteBatchedInserts=true: 배치 적재가 멀티로우 INSERT로 묶이게 한다(M1 A2/M2 측정 전제).
DB_URL=jdbc:postgresql://localhost:5432/locus?reWriteBatchedInserts=true
DB_USERNAME=locus
DB_PASSWORD=locuspw

# 수집 적재 모드. 기본=direct(A0 단건, standalone·테스트 안전).
#   · 프로덕션(stream 적재, M4b 확정 워커4·MAXLEN400K): 프로파일로 활성화 — 아래 한 줄.
#     SPRING_PROFILES_ACTIVE=stream        # Redis 상시 필요. src/main/resources/application-stream.yml
#   · queue(A2/M2 인메모리 배치) 측정: 주석 해제.
#     INGEST_MODE=queue
#   · 워커/큐/풀은 측정마다 명시하는 게 안전(상시 오버라이드는 confounder 위험 — M-http-capacity.md 참조).
#     예) INGEST_WORKERS=4  INGEST_QUEUE_CAPACITY=200000  DB_POOL_MAX=20

# --- 인증 (M4에서 추가) ---
# JWT_SECRET=    # 실제 비밀. 커밋 금지. M4 인증 구현 시 채움.
