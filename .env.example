# 로컬 개발용 환경변수 템플릿.
#   사용:  cp .env.example .env   (docker-compose가 .env를 자동으로 읽음)
# 실제 .env는 .gitignore 대상 — 절대 커밋하지 않는다(SECURITY.md).
# 아래 값은 로컬 docker-compose 전용 throwaway. 실제 환경에선 안전한 값으로 교체.

# --- MySQL 컨테이너 (docker-compose) ---
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=locus
MYSQL_USER=locus
MYSQL_PASSWORD=locuspw

# --- 애플리케이션 (Spring) ---
DB_URL=jdbc:mysql://localhost:3306/locus?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=locus
DB_PASSWORD=locuspw

# --- 인증 (M4에서 추가) ---
# JWT_SECRET=    # 실제 비밀. 커밋 금지. M4 인증 구현 시 채움.
