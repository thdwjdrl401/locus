# 로컬 개발용 환경변수 템플릿.
#   사용:  cp .env.example .env   (docker-compose가 .env를 자동으로 읽음)
# 실제 .env는 .gitignore 대상 — 절대 커밋하지 않는다(SECURITY.md).
# 아래 값은 로컬 docker-compose 전용 throwaway. 실제 환경에선 안전한 값으로 교체.

# --- TimescaleDB(PostgreSQL) 컨테이너 (docker-compose) ---
POSTGRES_DB=locus
POSTGRES_USER=locus
POSTGRES_PASSWORD=locuspw

# Locus docker DB가 호스트에 발행할 포트. 기본 5432.
# 박스에 시스템 PostgreSQL이 5432를 점유하면 .env에서 다른 포트로 분리.
DB_HOST_PORT=5432

# --- 애플리케이션 (Spring) ---
# 포트를 DB_HOST_PORT와 맞춘다.
# reWriteBatchedInserts=true: M1 A2 배치 적재가 멀티로우 INSERT로 묶이게 한다(전제).
DB_URL=jdbc:postgresql://localhost:5432/locus?reWriteBatchedInserts=true
DB_USERNAME=locus
DB_PASSWORD=locuspw

# --- 인증 (M4에서 추가) ---
# JWT_SECRET=    # 실제 비밀. 커밋 금지. M4 인증 구현 시 채움.
